SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=your-server-only-secret-key
# Encode special characters in the password. Use the transaction pooler on Vercel.
DATABASE_URL=postgresql://postgres.your-project-ref:YOUR_PASSWORD@YOUR_POOLER_HOST:6543/postgres
SUPABASE_DB_SCHEMA=taskforce_app
SUPABASE_STORAGE_BUCKET=taskforce-files
# Match the office timezone so the existing local-date rules keep their meaning.
TZ=Australia/Adelaide
# Random secret for the protected Vercel cron endpoint.
CRON_SECRET=
