SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=your-server-only-secret-key
# Encode password special characters. Use the session pooler for Render/local Node.
DATABASE_URL=postgresql://postgres.your-project-ref:YOUR_PASSWORD@YOUR_POOLER_HOST:5432/postgres
SUPABASE_DB_SCHEMA=taskforce_app
SUPABASE_STORAGE_BUCKET=taskforce-files
# Match the office timezone so the existing local-date rules keep their meaning.
TZ=Australia/Adelaide
# Random secret shared with the GitHub Actions scheduled-job request.
CRON_SECRET=
# Optional: external disables internal startup/repeating jobs when GitHub runs jobs.
# The database coordinates both triggers if the internal timer is left enabled.
TF_SCHEDULER=internal
# Maximum concurrent PostgreSQL connections for this server process.
PG_POOL_MAX=10
