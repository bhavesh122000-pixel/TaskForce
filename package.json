{
  "name": "taskforce",
  "version": "1.0.0",
  "description": "TaskForce - task and matter tracker for a small conveyancing office",
  "main": "server.js",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "node --no-warnings server.js",
    "backup": "node --env-file-if-exists=.env.local --no-warnings scripts/backup.js",
    "setup:supabase": "node --env-file-if-exists=.env.local --no-warnings scripts/setup-supabase.js",
    "build": "node scripts/check.js",
    "test": "node --no-warnings --test tests/*.test.js"
  },
  "dependencies": {
    "@kenjiuno/msgreader": "^1.22.0",
    "express": "^4.21.2",
    "mailparser": "^3.7.2",
    "mammoth": "^1.13.0",
    "multer": "^2.0.0",
    "nodemailer": "^6.10.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11"
  }
}
